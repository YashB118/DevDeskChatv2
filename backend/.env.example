NODE_ENV=development
PORT=3005
LOG_LEVEL=info
APP_NAME=devdeskchat-backend

# CORS allowlist (comma-separated origins). Use * only in local dev.
# Frontend Vite dev server runs on :5173 — keep it whitelisted.
CORS_ORIGINS=http://localhost:5173

# Body parser
BODY_LIMIT=2mb

# Trust proxy (set to true behind a load balancer)
TRUST_PROXY=false

# Postgres
DATABASE_URL=postgres://devdesk:devdesk@localhost:5432/devdesk
PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=5000
PG_IDLE_IN_TX_TIMEOUT_MS=30000
# TLS to Postgres. Set true when DATABASE_URL has ?sslmode=require (managed clouds: Aiven, Supabase, RDS, …).
# Local docker Postgres without TLS: leave false.
PG_SSL=false
# Verify the server certificate chain. Default true. Keep true in production.
# Set false only for local dev against a cloud DB whose CA isn't in Node's trust store AND you can't supply PG_SSL_CA.
PG_SSL_REJECT_UNAUTHORIZED=true
# PEM-encoded CA cert (or chain). Pins the trust anchor; takes precedence over PG_SSL_REJECT_UNAUTHORIZED.
# Multi-line PEM must be wrapped in double quotes for dotenv to parse correctly.
# PG_SSL_CA="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"

# Redis
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=devdesk:

# Auth — JWT (RS256). Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl rsa -in jwt.key -pubout -out jwt.key.pub
# Multi-line PEM must be wrapped in double quotes, OR escape newlines as `\n`.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=devdeskchat
JWT_AUDIENCE=devdeskchat-clients

# Auth — refresh tokens (opaque, rotated, cookie-bound)
REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=dd_refresh
REFRESH_COOKIE_PATH=/api/auth
# Keep true in production. Set false only for local plain-HTTP dev.
REFRESH_COOKIE_SECURE=true
# Optional. Set when serving over a parent domain (e.g. .example.com).
# REFRESH_COOKIE_DOMAIN=

# Auth — password hashing
BCRYPT_COST=12
