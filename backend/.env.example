NODE_ENV=development
PORT=3005
LOG_LEVEL=info
APP_NAME=devdeskchat-backend

# CORS allowlist (comma-separated origins). Use * only in local dev.
# Frontend Vite dev server runs on :5173 — keep it whitelisted.
CORS_ORIGINS=http://localhost:5173

# Body parser
BODY_LIMIT=2mb

# Trust proxy (set to true behind a load balancer)
TRUST_PROXY=false

# Postgres
DATABASE_URL=postgres://devdesk:devdesk@localhost:5432/devdesk
PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=5000
PG_IDLE_IN_TX_TIMEOUT_MS=30000
# TLS to Postgres. Set true when DATABASE_URL has ?sslmode=require (managed clouds: Aiven, Supabase, RDS, …).
# Local docker Postgres without TLS: leave false.
PG_SSL=false
# Verify the server certificate chain. Default true. Keep true in production.
# Set false only for local dev against a cloud DB whose CA isn't in Node's trust store AND you can't supply PG_SSL_CA.
PG_SSL_REJECT_UNAUTHORIZED=true
# PEM-encoded CA cert (or chain). Pins the trust anchor; takes precedence over PG_SSL_REJECT_UNAUTHORIZED.
# Multi-line PEM must be wrapped in double quotes for dotenv to parse correctly.
# PG_SSL_CA="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"

# Redis
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=devdesk:

# Auth — JWT (RS256). Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl rsa -in jwt.key -pubout -out jwt.key.pub
# Multi-line PEM must be wrapped in double quotes, OR escape newlines as `\n`.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=devdeskchat
JWT_AUDIENCE=devdeskchat-clients

# Auth — refresh tokens (opaque, rotated, cookie-bound)
REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=dd_refresh
REFRESH_COOKIE_PATH=/api/auth
# Keep true in production. Set false only for local plain-HTTP dev.
REFRESH_COOKIE_SECURE=true
# Optional. Set when serving over a parent domain (e.g. .example.com).
# REFRESH_COOKIE_DOMAIN=

# Auth — password hashing
BCRYPT_COST=12

# Queues — BullMQ (Phase 5)
# Prefix isolates queue keys in Redis (avoids collisions with REDIS_KEY_PREFIX clients).
QUEUE_PREFIX=devdesk-bull
QUEUE_DEFAULT_ATTEMPTS=5
QUEUE_DEFAULT_BACKOFF_MS=1000
# Retention counts for completed/failed job records (0 = keep none).
QUEUE_REMOVE_ON_COMPLETE=1000
QUEUE_REMOVE_ON_FAIL=5000

# WAHA HTTP client (Phase 6)
# Base URL of the WAHA instance (NoWeb engine).
WAHA_BASE_URL=http://localhost:3000
# Optional: sent as X-Api-Key on every request. Leave unset for unauthenticated WAHA.
# WAHA_API_KEY=
# Request timeouts: default for JSON, media for uploads (sendImage/sendFile).
WAHA_TIMEOUT_MS=5000
WAHA_MEDIA_TIMEOUT_MS=30000
# Retry policy applies to idempotent GETs only (5xx + network errors).
WAHA_RETRY_MAX=3
WAHA_RETRY_BASE_MS=150
# Per-method circuit breaker: open after N consecutive failures, cool down for X ms.
WAHA_CB_FAILURE_THRESHOLD=5
WAHA_CB_COOLDOWN_MS=30000
# In-memory cache TTLs (0 = disabled).
WAHA_SESSIONS_CACHE_TTL_MS=10000
WAHA_CHATS_CACHE_TTL_MS=10000
WAHA_STATUS_CACHE_TTL_MS=5000

# WAHA NOWEB SQLite store (Phase 6) — read-only reader for rowid sort + JID lookup.
WAHA_STORE_PATH=/var/lib/waha/store.db
# Boot-time check that the file is mounted read-only (no write access for the process user).
# Keep true in production. Set false in local dev where the file is writable.
WAHA_STORE_REQUIRE_READONLY=false
WAHA_STORE_CACHE_TTL_MS=60000

# WAHA webhook ingestion (Phase 7)
# Optional HMAC shared secret. When set, every webhook request must carry a matching
# X-Webhook-Hmac header (hex SHA-256 over the raw body). Leave unset to disable verification.
# WAHA_WEBHOOK_HMAC_SECRET=
WAHA_WEBHOOK_HMAC_HEADER=x-webhook-hmac
# Pending-send reconciliation window (must outlive WAHA round-trip + webhook delivery).
PENDING_MESSAGE_TTL_MS=9000

# Observability (Phase 10)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=devdeskchat-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_TRACES_SAMPLER_RATIO=1
# /metrics gating — leave unset to keep the endpoint closed.
# METRICS_BEARER_TOKEN=
HEALTH_WAHA_CACHE_TTL_MS=15000
HEALTH_WAHA_TIMEOUT_MS=2500

# Security hardening (Phase 11)
# Master toggle. Off only for unit tests / load runs.
RATE_LIMIT_ENABLED=true
# Hard request budget (ms). 503 emitted on timeout.
REQUEST_TIMEOUT_MS=30000
# Global IP — anti-abuse floor before authentication.
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_IP_MAX=600
# Per-authenticated-user API budget.
RATE_LIMIT_USER_WINDOW_SECONDS=60
RATE_LIMIT_USER_MAX=300
# Login attempts per email — slow brute force without locking real users out.
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_AUTH_MAX=5
# Send-message budget per user.
RATE_LIMIT_SEND_WINDOW_SECONDS=10
RATE_LIMIT_SEND_MAX=30
# Soft chats-list budget. When exceeded, the cached chat list is served with
# X-RateLimit-Cached: true instead of a 429.
RATE_LIMIT_CHATS_WINDOW_SECONDS=5
RATE_LIMIT_CHATS_MAX=10
# HSTS max-age (seconds). Defaults to 2 years.
HSTS_MAX_AGE_SECONDS=63072000
