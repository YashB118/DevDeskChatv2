{
  "name": "@devdesk/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod event/contract schemas between backend and frontend.",
  "main": "./dist/cjs/events.js",
  "module": "./dist/esm/events.js",
  "types": "./dist/cjs/events.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/events.d.ts",
      "import": "./dist/esm/events.js",
      "require": "./dist/cjs/events.js",
      "default": "./dist/cjs/events.js"
    },
    "./events": {
      "types": "./dist/cjs/events.d.ts",
      "import": "./dist/esm/events.js",
      "require": "./dist/cjs/events.js",
      "default": "./dist/cjs/events.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build": "npm run build:cjs && npm run build:esm",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "zod": "^3.23"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
