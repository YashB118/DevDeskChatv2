{
  "name": "@devdesk/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod event/contract schemas between backend and frontend.",
  "main": "./dist/events.js",
  "types": "./dist/events.d.ts",
  "exports": {
    ".": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "zod": "^3.23"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
